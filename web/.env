# Web build — public/user variant. Admin features (Admin Panel, Admin login,
# cloud resumes tab) are compiled out unless explicitly enabled.
# This mirrors the user.apk behaviour; the Android APK is built from frontend/.
VITE_ADMIN_BUILD=false

# Optional: URL of a deployed backend (Flask API). When unset, the app runs
# fully client-side (offline mode): editing, preview, PDF, import all work;
# online AI polish / feedback / cloud sync are disabled gracefully.
# VITE_API_URL=https://api.example.com
