# Web build — public/user variant. The Android APK is built from frontend/.
# Owner-only features (Admin Panel) are unlocked by signing in with the owner
# account; they are invisible to everyone else (see web/src/auth.js).

# Optional: URL of a deployed backend (Flask API). When unset, the app runs
# fully client-side (offline mode): accounts, editing, AI drafting, preview,
# PDF and import all work; online AI polish / feedback / cloud sync are
# disabled gracefully.
# VITE_API_URL=https://api.example.com
